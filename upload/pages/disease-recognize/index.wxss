.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 60rpx;
  background: #F5F5F5;
}

.batch-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.06);
}

.batch-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.batch-state {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.batch-state--error {
  justify-content: space-between;
}

.batch-retry {
  color: #FF8C00;
}

.batch-picker-field {
  background: #F7F7F7;
  border-radius: 14rpx;
  min-height: 84rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.batch-picker-value {
  font-size: 28rpx;
  color: #333;
}

.batch-picker-placeholder {
  font-size: 28rpx;
  color: #c8c9cc;
}

.upload-wrapper {
  margin-bottom: 32rpx;
}

.upload-box {
  background: #fff;
  border: 4rpx dashed #FF8C00;
  border-radius: 24rpx;
  padding: 48rpx 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.preview-box {
  position: relative;
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.preview-img {
  width: 100%;
  height: 480rpx;
  display: block;
}

.preview-remove {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn {
  margin-bottom: 8rpx;
}

.btn-icon {
  margin-right: 10rpx;
}

.result-section {
  animation: fadeUp 0.35s ease-out;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.result-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 0, 0.10);
  border-left: 10rpx solid #FF8C00;
  margin-bottom: 32rpx;
}

.result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.result-label {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
}

.metric-row {
  display: flex;
  align-items: center;
  background: #FAFAFA;
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 28rpx;
}

.metric-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.metric-value.highlight {
  color: #FF8C00;
}

.metric-title {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.metric-divider {
  width: 2rpx;
  height: 64rpx;
  background: #E0E0E0;
}

.advice-box {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #FFF7ED;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.advice-icon {
  margin-right: 16rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.advice-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
}

.review-bar {
  border-radius: 12rpx;
  overflow: hidden;
}

.save-btn {
  margin-top: 8rpx;
}

.tips {
  display: flex;
  align-items: flex-start;
  padding: 32rpx;
  margin-top: 24rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #bbb;
  margin-left: 12rpx;
  line-height: 1.6;
}

.ai-suggestion-box {
  margin-bottom: 20rpx;
  padding: 22rpx;
  background: #F9FAFB;
  border-radius: 14rpx;
  border: 1rpx solid #E5E7EB;
}

.ai-suggestion-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.ai-suggestion-summary {
  display: block;
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
}

.ai-suggestion-action {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
}

.ai-suggestion-risk {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A6D3B;
}

<view class="container">
  <block wx:if="{{!isLogin}}">
    <view class="user-card login-card" bindtap="goLogin">
      <view class="avatar-wrap">
        <view class="avatar-placeholder">
          <text class="avatar-text">登录</text>
        </view>
      </view>
      <view class="user-main login-main">
        <text class="nickname">点击登录</text>
        <text class="user-line">登录后可查看批次二维码与今日操作记录</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="user-card">
      <view class="avatar-wrap">
        <image
          wx:if="{{userInfo.avatar}}"
          class="avatar"
          src="{{userInfo.avatar}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar-placeholder">
          <text class="avatar-text">{{(userInfo.nickname && userInfo.nickname[0]) || '橘'}}</text>
        </view>
      </view>

      <view class="user-main">
        <text class="nickname">{{userInfo.nickname || '用户'}}</text>
        <text class="user-line" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</text>
        <text class="user-line">{{userInfo.roleText || '角色：未设置'}}</text>

        <view class="inline-status" wx:if="{{profileLoading}}">
          <text class="status-tip">资料更新中...</text>
        </view>
        <view class="inline-status error" wx:if="{{profileLoadFailed}}">
          <text class="status-tip">资料更新失败</text>
          <text class="retry-link" bindtap="onRetryProfile">重试</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <text class="section-title">批次二维码</text>
          <text class="section-subtitle">优先展示已生成二维码的批次（共 {{qrcodeTotal}} 项）</text>
        </view>
        <text class="section-link" bindtap="onViewMoreQrcode" wx:if="{{qrcodeTotal > 0}}">查看更多</text>
      </view>

      <view class="section-state" wx:if="{{qrcodeLoading}}">
        <van-loading size="40rpx" vertical>加载中...</van-loading>
      </view>

      <view class="section-state" wx:elif="{{qrcodeLoadFailed}}">
        <text class="state-text">批次二维码加载失败</text>
        <van-button
          round
          type="warning"
          size="small"
          color="#FF8C00"
          bindtap="onRetryQrcode"
          custom-class="state-btn"
        >重新加载</van-button>
      </view>

      <view class="section-state" wx:elif="{{qrcodeList.length === 0}}">
        <text class="state-text">暂无批次产品数据</text>
        <text class="state-subtext">完成分级后可在这里直接生成二维码</text>
      </view>

      <view wx:else>
        <view class="qrcode-item" wx:for="{{qrcodeList}}" wx:key="id">
          <view class="qrcode-head">
            <view class="qrcode-title-group">
              <text class="qrcode-title">{{item.batchName || '--'}}</text>
              <text class="qrcode-meta">{{item.variety || '--'}} · {{item.grade || '--'}}</text>
            </view>
            <text class="qrcode-tag {{item.qrcodeGenerated ? 'generated' : 'pending'}}">
              {{item.qrcodeGenerated ? '已生成' : '未生成'}}
            </text>
          </view>

          <view class="info-row">
            <text class="info-label">状态</text>
            <text class="info-value">{{item.status || '--'}}</text>
          </view>

          <view class="info-row">
            <text class="info-label">溯源码</text>
            <view class="trace-wrap">
              <text class="info-value code">{{item.traceCode || '--'}}</text>
              <text
                class="inline-action {{!item.traceCode ? 'disabled' : ''}}"
                data-code="{{item.traceCode}}"
                bindtap="onCopyTraceCode"
              >复制</text>
            </view>
          </view>

          <view class="action-row">
            <view
              class="action-btn ghost {{generatingId ? 'disabled' : ''}}"
              data-id="{{item.id}}"
              bindtap="onGenerateQrcode"
            >
              <text>{{generatingId === item.id ? '生成中...' : (item.qrcodeGenerated ? '重新生成' : '生成二维码')}}</text>
            </view>

            <view
              class="action-btn ghost {{!item.qrcodeGenerated ? 'disabled' : ''}}"
              data-id="{{item.id}}"
              bindtap="onPreviewQrcode"
            >
              <text>预览二维码</text>
            </view>

            <view
              class="action-btn primary {{!item.traceCode ? 'disabled' : ''}}"
              data-code="{{item.traceCode}}"
              bindtap="onViewTrace"
            >
              <text>溯源详情</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <text class="section-title">今日操作记录</text>
          <text class="section-subtitle">今日共 {{historyTotal}} 条记录</text>
        </view>
        <text class="section-link" bindtap="onViewMoreHistory" wx:if="{{historyTotal > 0}}">查看更多</text>
      </view>

      <view class="section-state" wx:if="{{historyLoading}}">
        <van-loading size="40rpx" vertical>加载中...</van-loading>
      </view>

      <view class="section-state" wx:elif="{{historyLoadFailed}}">
        <text class="state-text">今日记录加载失败</text>
        <van-button
          round
          type="warning"
          size="small"
          color="#FF8C00"
          bindtap="onRetryHistory"
          custom-class="state-btn"
        >重新加载</van-button>
      </view>

      <view class="section-state" wx:elif="{{historyList.length === 0}}">
        <text class="state-text">今天还没有操作记录</text>
      </view>

      <view wx:else>
        <view class="history-item" wx:for="{{historyList}}" wx:key="historyKey">
          <text class="history-time">{{item.displayTime}}</text>
          <view class="history-content">
            <text class="history-type">{{item.displayType}}</text>
            <text class="history-desc">{{item.displayContent}}</text>
            <text class="history-batch" wx:if="{{item.batchName}}">批次：{{item.batchName}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card account-card">
      <view class="section-head">
        <text class="section-title">账号操作</text>
      </view>
      <button class="logout-btn" bindtap="onLogout">退出登录</button>
    </view>
  </block>
</view>

# ============================================
# Orange backend environment example
# Copy this file to .env and update values
# ============================================

# ---------- app ----------
PORT=8080
NODE_ENV=development
APP_ENV=development

# ---------- database ----------
DATABASE_URL="mysql://root:@localhost:3306/orange_db"

# ---------- redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- jwt ----------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ---------- upload ----------
UPLOAD_MODE=local
UPLOAD_DIR=./uploads
LOCAL_UPLOAD_DIR=./uploads

# ---------- minio ----------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=orange
MINIO_USE_SSL=false

# ---------- disease ai ----------
DISEASE_AI_BASE_URL=http://127.0.0.1:9001
DISEASE_AI_PREDICT_PATH=/ai/disease/predict
DISEASE_AI_TIMEOUT_MS=15000
DISEASE_AI_API_KEY=

# ---------- unified ai inference ----------
AI_SERVICE_URL=http://127.0.0.1:9001
AI_SERVICE_TIMEOUT_MS=15000
FRUIT_PERCEPTION_PATH=/ai/fruit/perception
MODEL_PATH=
ENABLE_AI_MOCK=false

# ---------- weather provider ----------
WEATHER_PROVIDER=real
WEATHER_API_KEY=
WEATHER_DEFAULT_LOCATION_ID=30.5928,114.3055
# WEATHER_PROVIDER=real 使用 Open-Meteo（免 key）。
# WEATHER_DEFAULT_LOCATION_ID 可选，格式为 "纬度,经度"；不填时默认武汉坐标。

# ---------- trace proof provider ----------
TRACE_PROOF_PROVIDER=hash
TRACE_ANCHOR_ENABLED=false
TRACE_ANCHOR_PROVIDER=hash
TRACE_ANCHOR_TIMEOUT_MS=10000
TRACE_CHAIN_PROVIDER=hash
TRACE_CHAIN_NETWORK=sepolia
TRACE_NOTARY_BASE_URL=
TRACE_NOTARY_ANCHOR_PATH=/v1/anchors
TRACE_NOTARY_STATUS_PATH=/v1/anchors/{id}
TRACE_NOTARY_API_KEY=
EVM_RPC_URL=https://sepolia.infura.io/v3/e6f55d0d404b4225b4b9caefa2f66079
EVM_PRIVATE_KEY=0x163706d54383136d8812670b58e00ba0bba6a56e06954e7c1cbe22d0cbf36633
EVM_CHAIN_ID=11155111
EVM_CHAIN_NAME=sepolia
EVM_CONTRACT_ADDRESS=0xec634E0f98Efa6dD11366658CA1B63cb73A20176
EVM_INITIAL_OWNER=

# ---------- wechat mini program code ----------
WECHAT_MP_CODE_ENABLED=false
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_CODE_PAGE=pages/trace-view/index
WECHAT_MP_ENV_VERSION=release
WECHAT_MP_CODE_WIDTH=430
WECHAT_MP_CODE_AUTO_COLOR=true
WECHAT_MP_TIMEOUT_MS=10000

# ---------- llm (legacy compatible) ----------
LLM_ENABLED=false
LLM_BASE_URL=
LLM_CHAT_PATH=/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_OBSERVE_ENABLED=false

# ---------- openai preferred (priority: OPENAI_* > DEEPSEEK_* > LLM_*) ----------
OPENAI_API_KEY=sk-E8vhv3yVCVGckQW9RP3r6R5by5xiP0iYFV9q77iKGGu5gzNQ
OPENAI_BASE_URL=https://tb.api.mkeai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=2

# ---------- deepseek compatible ----------
DEEPSEEK_API_KEY=sk-E8vhv3yVCVGckQW9RP3r6R5by5xiP0iYFV9q77iKGGu5gzNQ
DEEPSEEK_BASE_URL=https://tb.api.mkeai.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_MAX_RETRIES=2

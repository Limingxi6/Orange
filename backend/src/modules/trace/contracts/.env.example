# EVM testnet RPC endpoint (Sepolia example)
EVM_RPC_URL=https://sepolia.infura.io/v3/<your_api_key>

# Deployer private key (32-byte hex, with or without 0x)
EVM_PRIVATE_KEY=0x<your_private_key>

# Target chain config
EVM_CHAIN_ID=11155111
EVM_CHAIN_NAME=sepolia

# Optional: TraceAnchor initial owner; defaults to deployer address when empty
EVM_INITIAL_OWNER=

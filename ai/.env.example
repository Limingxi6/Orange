# External model API gateway (priority: OPENAI_* > DEEPSEEK_* > LLM_*)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=2

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_MAX_RETRIES=2

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=
LLM_MAX_RETRIES=

# Local disease model
# Supports file path or directory containing disease_classifier_leaves.pt
MODEL_PATH=./models/disease_classifier_leaves.pt
DISEASE_MODEL_PATH=./models/disease_classifier_leaves.pt
DISEASE_LABEL_MAP_PATH=./models/disease_label_mapping.json
DISEASE_LOW_CONFIDENCE_THRESHOLD=0.65
DISEASE_MODEL_VERSION=local-model-v1

# Local fruit grade model (tabular)
FRUIT_GRADE_MODEL_PATH=./models/fruit_grade/grade_model.joblib

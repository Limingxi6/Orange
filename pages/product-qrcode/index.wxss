.container {
  padding: 24rpx;
}

.page-header {
  margin-bottom: 24rpx;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.page-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  line-height: 1.5;
}

.scan-entry {
  background: linear-gradient(135deg, #fff8ef, #fff2dc);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.scan-copy {
  flex: 1;
  min-width: 0;
}

.scan-title {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.scan-desc {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  line-height: 1.5;
}

.scan-btn {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 10rpx;
  background: #ff8c00;
  color: #fff;
  font-size: 24rpx;
}

.product-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.product-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.product-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.product-variety {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.tag-success {
  background: #e8f5e9;
  color: #4caf50;
}

.tag-pending {
  background: #fff3e0;
  color: #ff9800;
}

.product-detail {
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  gap: 20rpx;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

.detail-value.price {
  color: #ff8c00;
  font-weight: 600;
}

.detail-value.code {
  color: #666;
  font-family: 'Courier New', monospace;
  font-size: 22rpx;
}

.detail-code-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
}

.copy-inline {
  flex-shrink: 0;
  color: #ff8c00;
  font-size: 22rpx;
}

.copy-inline.disabled {
  color: #bbb;
  pointer-events: none;
}

.product-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.action-btn {
  width: calc(50% - 6rpx);
  text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  font-size: 24rpx;
  background: #f5f5f5;
  color: #666;
}

.action-btn.primary {
  background: #ff8c00;
  color: #fff;
}

.action-btn.disabled,
.scan-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

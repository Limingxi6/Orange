.page {
  min-height: 100vh;
  background: #f4f4f4;
  padding: 0 0 36rpx;
}

.trace-head {
  margin: 24rpx;
  padding: 26rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ff8c00, #ffa726);
  color: #fff;
}

.trace-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.trace-code {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  opacity: 0.95;
  font-family: 'Courier New', monospace;
}

.trace-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  opacity: 0.9;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.result-card {
  background: linear-gradient(135deg, #fff8ef, #fff2dc);
}

.result-main {
  margin-bottom: 16rpx;
}

.result-batch {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 700;
}

.result-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 6rpx 0;
}

.label {
  width: 180rpx;
  font-size: 24rpx;
  color: #888;
  flex-shrink: 0;
}

.value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
}

.value.mono {
  font-size: 22rpx;
  color: #666;
  font-family: 'Courier New', monospace;
}

.quality-main {
  margin-bottom: 16rpx;
}

.grade-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #fff2dc;
  color: #ff8c00;
  font-size: 26rpx;
  font-weight: 700;
}

.score-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.score-item {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 14rpx;
  text-align: center;
}

.score-item.defect {
  background: #fff1f1;
}

.score-name {
  display: block;
  font-size: 22rpx;
  color: #888;
}

.score-value {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #ff8c00;
  font-weight: 700;
}

.score-item.defect .score-value {
  color: #ef5350;
}

.summary-box {
  background: #fff8ef;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 18rpx;
}

.summary-title {
  display: block;
  font-size: 24rpx;
  color: #ff8c00;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.summary-line {
  display: block;
  font-size: 24rpx;
  color: #555;
  line-height: 1.55;
  margin-top: 4rpx;
}

.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.timeline-item {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.timeline-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff8c00;
  margin-top: 11rpx;
  flex-shrink: 0;
}

.timeline-body {
  flex: 1;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 14rpx;
}

.timeline-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
}

.timeline-type {
  font-size: 24rpx;
  color: #333;
  font-weight: 600;
}

.timeline-time {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

.timeline-content {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
}

.disease-main {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 14rpx;
  margin-bottom: 14rpx;
}

.disease-name {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

.disease-date {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.trust-card {
  padding-bottom: 22rpx;
}

.verify-banner {
  display: flex;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.verify-banner.verified {
  background: #e8f5e9;
}

.verify-banner.failed {
  background: #ffebee;
}

.verify-banner.pending {
  background: #fff3e0;
}

.verify-copy {
  flex: 1;
}

.verify-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 700;
}

.verify-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.copy-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.copy-btn {
  font-size: 22rpx;
  color: #ff8c00;
  flex-shrink: 0;
}

.verify-btn {
  margin-top: 18rpx;
}

.ai-summary-card {
  border-left: 6rpx solid #FFB74D;
}

.ai-summary-text {
  display: block;
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
}

.ai-summary-action {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
}

.ai-summary-risk {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A6D3B;
}
